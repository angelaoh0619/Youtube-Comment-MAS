YOUTUBE_API_KEY=your_youtube_api_key
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-6.2-sol
OPENAI_REASONING_EFFORT=medium
# Optional: openai or openrouter. Without this, an OpenAI key takes priority.
# LLM_PROVIDER=openai
# Alternative provider:
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional; must support structured_outputs.
OPENROUTER_MODEL=openai/gpt-4.1-mini
# For OpenAI reasoning models through OpenRouter (for example openai/gpt-6.2-sol):
# OPENROUTER_REASONING_EFFORT=medium

# Deployment: the API verifies browser sessions against this Firebase project.
# Leave unset when running the original local-only server.
# FIREBASE_PROJECT_ID=review-agents-20261124
# ALLOWED_ORIGINS=https://your-app.vercel.app
# Optional deployment-only overrides; local model selection remains unchanged:
# DEPLOY_LLM_PROVIDER=openrouter
# DEPLOY_MODEL=openai/gpt-6.2-sol
# DEPLOY_REASONING_EFFORT=medium
